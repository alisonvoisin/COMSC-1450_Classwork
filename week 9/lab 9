import tkinter as tk
from turtle import color
def display(color_name):
    l.config(text=color + " selected")

root=tk.Tk()
root.title("menu lab")
root.geometry("300x200")

main_menu=tk.Menu(root)
f1=tk.Menu(main_menu)
f1.add_command(label="red", command=lambda: display("red"))
f1.add_command(label="blue", command=lambda: display("blue"))
main_menu.add_cascade(label="color", menu=f1)
root.config(menu=main_menu)

l=tk.Label(root, text="No color selected")
l.pack()
root.mainloop()