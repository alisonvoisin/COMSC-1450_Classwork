#3
try:
    f=open("grades.txt", "r")
    total=0
    for i in f:
        total+=int(i)
except FileNotFoundError as e:
    print("File not found")
except ValueError as e:
    print("Invalid value in file")
else:
    print(total)



#4
amount=500
try:
    x= int(input("enter withdrawl amount: "))
    if x<=0:
        raise ValueError("Withdrawl amount must be positive")
    if x>amount:
        raise ValueError("Insufficient funds")
except ValueError as e: 
    print(e)
else:
    amount=amount-x
    print("Withdrawl successful. Remaining balance:", amount)